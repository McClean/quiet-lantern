{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adapter manifest v1",
  "type": "object",
  "required": [
    "contract",
    "id",
    "name",
    "licence",
    "runtime",
    "systems",
    "buttons",
    "capabilities"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "licence": {
      "type": "string",
      "minLength": 1,
      "description": "SPDX id of the core"
    },
    "priority": {
      "type": "integer",
      "default": 0
    },
    "runtime": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "wasm",
            "external"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^core/[A-Za-z0-9._-]+$"
          },
          "description": "served by GET /core/<id>/<file>; required for wasm"
        },
        "binding": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+\\.mjs$"
        }
      }
    },
    "systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "extensions"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string"
          },
          "extensions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^\\.[a-z0-9]+$"
            }
          },
          "header": {
            "type": "object",
            "required": [
              "offset",
              "hex"
            ],
            "additionalProperties": false,
            "properties": {
              "offset": {
                "type": "integer",
                "minimum": 0
              },
              "hex": {
                "type": "string",
                "pattern": "^([0-9a-f]{2})+$"
              }
            }
          },
          "codeAt": {
            "type": "object",
            "required": [
              "offset",
              "length"
            ],
            "additionalProperties": false,
            "properties": {
              "offset": {
                "type": "integer",
                "minimum": 0
              },
              "length": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16
              }
            }
          },
          "titleAt": {
            "type": "object",
            "required": [
              "offset",
              "length"
            ],
            "additionalProperties": false,
            "properties": {
              "offset": {
                "type": "integer",
                "minimum": 0
              },
              "length": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              }
            }
          }
        }
      }
    },
    "buttons": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "A",
          "B",
          "X",
          "Y",
          "L",
          "R",
          "L2",
          "R2",
          "START",
          "SELECT",
          "UP",
          "DOWN",
          "LEFT",
          "RIGHT"
        ]
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "video",
          "input",
          "save_state",
          "memory_read",
          "pause",
          "step",
          "audio",
          "screenshot",
          "battery_save"
        ]
      }
    },
    "memory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "start",
          "size"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "controls": {
      "type": "object",
      "description": "keyboard code -> button name",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": {
            "properties": {
              "kind": {
                "const": "wasm"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "runtime": {
            "required": [
              "kind",
              "files",
              "binding"
            ]
          }
        }
      }
    }
  ]
}
